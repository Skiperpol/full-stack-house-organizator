{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "warn"
  },
  "ignorePatterns": [
    "**/dist",
    "**/node_modules",
    "**/build",
    "**/dist-ssr",
    "**/*.local",
    "**/src/api/generated/**"
  ],
  "env": {
    "node": true,
    "browser": true
  }
}
